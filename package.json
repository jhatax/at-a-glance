{
  "name": "AtAGlance",
  "author": "Manoj Mehta",
  "description": "Get all the info you need, with a glance at your Pebble.",
  "version": "1.1.0",
  "keywords": [
    "pebble",
    "watchface"
  ],
  "license": "MIT",
  "dependencies": {
    "@rebble/clay": "^1.0.10"
