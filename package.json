{
  "name": "AtAGlance",
  "author": "Manoj Mehta",
  "description": "Get all the info you need, with a glance at your Pebble.",
  "version": "1.3.5",
  "keywords": [
    "pebble",
    "watchface"
  ],
  "license": "MIT",
  "scripts": {
    "format": "shfmt -i 2 -sr -ci -w $(git ls-files '*.sh' '*.zsh') && yapf --style=.style.yapf -i $(git ls-files '*.py') && clang-format -i $(git ls-files '*.c' '*.h') && prettier --write $(git ls-files '*.js' '*.jsx' '*.ts' '*.tsx' '*.json' '*.css' '*.scss' '*.yaml' '*.yml')",
    "format:check": "prettier --check src/pkjs *.js* */*.js* .prettierrc",
    "docs:check": "uv run --python 3.13 python tools/markdown_format.py --check",
    "docs:reflow": "uv run --python 3.13 python tools/markdown_format.py",
    "format:clang": "clang-format -i src/c/*.[ch] src/modules/*.[ch]",
    "test:harness": "PYTHONPATH=tools/harness_py uv run --python 3.13 python -m unittest discover -s tools/harness_py/unittests -p 'test_*.py'",
    "test:native": "tests/native/run.sh",
    "check": "npm run format && npm run docs:check && npm run test:harness && npm run test:native",
    "compile": "uv run --python 3.13 python -m compileall tools/"
  },
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "pebble": {
    "displayName": "At A Glance",
    "uuid": "62B9295D-D680-409D-991B-B07B033352F9",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "flint",
      "chalk",
      "aplite",
      "diorite",
      "basalt",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable",
      "location",
      "health"
    ],
    "messageKeys": [
      "TIME_FORMAT",
      "TEMP_UNIT",
      "TEMPERATURE",
      "WEATHER_CONDITION",
      "IS_DAY",
      "WEATHER_UPDATE_MINUTES",
      "DISPLAY_MODE",
      "HR_SAMPLE_MINUTES",
      "STEPS_GOAL",
      "STEPS_GOAL_PRESET",
      "STEPS_GOAL_CUSTOM",
      "MAYBE_CURRENT_LOCATION",
      "JS_READY"
    ],
