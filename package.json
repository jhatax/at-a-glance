{
  "name": "AtAGlance",
  "author": "Manoj Mehta",
  "description": "Get all the info you need, with a glance at your Pebble.",
  "version": "1.2.2",
  "keywords": [
    "pebble",
    "watchface"
  ],
  "license": "MIT",
  "scripts": {
    "format": "prettier --write src/pkjs *.js* */*.js* .prettierrc",
    "format:check": "prettier --check src/pkjs *.js* */*.js* .prettierrc",
    "docs:check": "python3 tools/markdown_format.py --check",
    "docs:reflow": "python3 tools/markdown_format.py",
    "format:clang": "clang-format -i src/c/*.[ch] src/modules/*.[ch]",
    "test:harness": "PYTHONPATH=tools/harness_py python3 -m unittest discover -s tools/harness_py/unittests -p 'test_*.py'",
    "test:harness:focused": "PYTHONPATH=tools/harness_py:tools/harness_py/unittests python3 -m unittest",
    "check": "npm run format && npm run docs:check && npm run format:clang && npm run test:harness"
  },
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "pebble": {
    "displayName": "At A Glance",
    "uuid": "62B9295D-D680-409D-991B-B07B033352F9",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "flint",
      "chalk",
      "aplite",
      "diorite",
      "basalt",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable",
      "location",
      "health"
    ],
    "messageKeys": [
      "TIME_FORMAT",
      "TEMP_UNIT",
      "TEMPERATURE",
      "WEATHER_CONDITION",
      "IS_DAY",
      "WEATHER_UPDATE_MINUTES",
      "DISPLAY_MODE",
      "HR_SAMPLE_MINUTES",
      "STEPS_GOAL",
      "STEPS_GOAL_PRESET",
      "STEPS_GOAL_CUSTOM",
      "MAYBE_CURRENT_LOCATION"
    ],
