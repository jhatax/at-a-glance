{
  "name": "AtAGlance",
  "author": "Manoj Mehta",
  "description": "Get all the info you need, with a glance at your Pebble!",
  "version": "1.0.0",
  "keywords": [
    "pebble",
    "watchface"
  ],
  "license": "MIT",
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "pebble": {
    "displayName": "At A Glance",
    "uuid": "62B9295D-D680-409D-991B-B07B033352F9",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "flint",
      "chalk",
      "aplite",
      "diorite",
      "basalt",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable",
      "location",
      "health"
    ],
    "messageKeys": [
      "TIME_FORMAT",
      "TEMP_UNIT",
      "TEMPERATURE",
      "WEATHER_CONDITION",
      "IS_DAY",
      "HR_SAMPLE_MINUTES",
      "DISPLAY_MODE",
      "STEPS_GOAL",
      "STEPS_GOAL_PRESET",
      "STEPS_GOAL_CUSTOM"
    ],
    "resources": {
      "media": [
        {
          "file": "images/icon.png",
          "name": "MENU_ICON",
          "type": "bitmap",
          "menuIcon": true
        },
        {
          "characterRegex": "[-0-9CF]",
          "file": "fonts/Antonio-Medium.ttf",
          "name": "FONT_COMPACT_TEXT_MEDIUM_18",
          "type": "font",
          "compatibility": "2.7"
        },
        {
          "characterRegex": "[-0-9CF]",
          "file": "fonts/Antonio-Medium.ttf",
          "name": "FONT_FULL_TEXT_MEDIUM_24",
          "type": "font",
          "compatibility": "2.7"
        },
        {
          "characterRegex": "[-0-9.A-Z]",
          "file": "fonts/Antonio-SemiBold.ttf",
          "name": "FONT_COMPACT_DATE_SEMIBOLD_18",
          "type": "font",
          "compatibility": "2.7"
        },
        {
          "characterRegex": "[-0-9.A-Z]",
          "file": "fonts/Antonio-SemiBold.ttf",
          "name": "FONT_FULL_DATE_SEMIBOLD_24",
          "type": "font",
          "compatibility": "2.7"
        },
        {
          "characterRegex": "[0-9:]",
          "file": "fonts/cabin-semibold-600-time-subset.ttf",
          "name": "FONT_COMPACT_TIME_SEMIBOLD_40",
          "type": "font",
          "compatibility": "2.7"
        },
        {
          "characterRegex": "[0-9:]",
          "file": "fonts/cabin-semibold-600-time-subset.ttf",
          "targetPlatforms": [
            "emery"
          ],
          "name": "FONT_FULL_TIME_SEMIBOLD_60",
          "type": "font",
          "compatibility": "2.7"
        },
        {
          "characterRegex": "[0-9:]",
          "file": "fonts/cabin-semibold-600-time-subset.ttf",
          "targetPlatforms": [
            "gabbro"
          ],
          "name": "FONT_FULL_TIME_SEMIBOLD_72",
          "type": "font",
          "compatibility": "2.7"
        },
        {
          "file": "images/walk_18.png",
          "name": "WALK_COMPACT",
          "type": "bitmap",
          "targetPlatforms": [
            "aplite",
            "chalk",
            "flint",
            "basalt",
            "diorite"
          ]
        },
        {
          "file": "images/walk_28.png",
