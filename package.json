{
  "name": "AtAGlance",
  "author": "Manoj Mehta",
  "description": "Get all the info you need, with a glance at your Pebble.",
  "version": "1.7.5",
  "keywords": [
    "pebble",
    "watchface"
  ],
  "license": "MIT",
  "scripts": {
    "format": "shfmt -i 2 -sr -ci -w $(git ls-files '*.sh' '*.zsh') && yapf --style=.style.yapf -i $(git ls-files '*.py') && clang-format -i $(git ls-files '*.c' '*.h') && prettier --write $(git ls-files '*.js' '*.jsx' '*.ts' '*.tsx' '*.json' '*.css' '*.scss' '*.yaml' '*.yml')",
    "format:check": "prettier --check src/pkjs *.js* */*.js* .prettierrc",
    "docs:check": "uv run --python 3.13 python tools/markdown_format.py --check",
    "docs:reflow": "uv run --python 3.13 python tools/markdown_format.py",
    "format:clang": "clang-format -i src/c/*.[ch] src/modules/*.[ch]",
    "test": "npm run test:native && npm run test:js && npm run test:harness",
    "test:harness": "PYTHONPATH=tools/harness_py uv run --python 3.13 python -m unittest discover -s tools/harness_py/unittests -p 'test_*.py'",
    "test:native": "tests/native/run.sh",
    "test:js": "node --test tests/js/*.test.js",
    "check": "npm run format && npm run docs:check && npm run test:harness && npm run test:native && npm run test:js",
    "compile": "uv run --python 3.13 python -m compileall tools/"
  },
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "pebble": {
    "displayName": "At A Glance",
    "uuid": "62B9295D-D680-409D-991B-B07B033352F9",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "flint",
      "chalk",
      "aplite",
      "diorite",
      "basalt",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable",
      "location",
      "health"
    ],
    "usesPermissions": [
      "Location",
      "Health",
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "open-meteo.com",
            "openstreetmap.org"
          ]
        }
      }
    ],
    "messageKeys": {
      "TEMP_UNIT": 10001,
      "TEMPERATURE": 10002,
      "WEATHER_CONDITION": 10003,
      "IS_DAY": 10004,
      "WEATHER_UPDATE_MINUTES": 10005,
      "DISPLAY_MODE": 10006,
      "HR_SAMPLE_MINUTES": 10007,
      "STEPS_GOAL": 10008,
      "STEPS_GOAL_PRESET": 10009,
      "STEPS_GOAL_CUSTOM": 10010,
      "MAYBE_CURRENT_LOCATION": 10011,
      "SYNC": 10012,
      "BATTERY_ORIENTATION": 10013
    },
