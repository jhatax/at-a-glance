{
  "name": "AtAGlance",
  "author": "Manoj Mehta",
  "description": "Get all the info you need, with a glance at your Pebble!",
  "version": "1.0.0",
  "keywords": [
    "pebble",
    "watchface"
  ],
  "license": "MIT",
  "dependencies": {
    "@rebble/clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "At A Glance",
    "uuid": "62B9295D-D680-409D-991B-B07B033352F9",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "flint",
      "emery",
      "basalt",
      "diorite"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable",
      "location",
      "health"
    ],
    "messageKeys": [
      "TIME_FORMAT",
      "TEMP_UNIT",
      "TEMPERATURE",
      "WEATHER_CONDITION",
      "IS_DAY",
      "HR_SAMPLE_MINUTES",
      "DISPLAY_MODE"
    ],
    "resources": {
      "media": [
        {
          "file": "images/icon.png",
          "name": "MENU_ICON",
          "type": "bitmap",
          "menuIcon": true
        },
        {
          "file": "fonts/unbounded-semibold-600-time.ttf",
          "name": "FONT_TIME_UNBOUNDED_48",
          "type": "font"
        },
        {
          "file": "images/walking_24.png",
          "name": "STEPS_WALKING_24",
          "type": "bitmap"
        }
      ]
    }
  }
}
