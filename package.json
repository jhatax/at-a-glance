{
  "name": "AtAGlance",
  "author": "Manoj Mehta",
  "description": "Get all the info you need, with a glance at your Pebble!",
  "version": "1.0.0",
  "keywords": [
    "pebble",
    "watchface"
  ],
  "license": "MIT",
  "dependencies": {
    "@rebble/clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "At A Glance",
    "uuid": "62B9295D-D680-409D-991B-B07B033352F9",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "flint",
      "emery",
      "basalt",
      "diorite",
      "chalk",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable",
      "location",
      "health"
    ],
    "messageKeys": [
      "TIME_FORMAT",
      "TEMP_UNIT",
      "TEMPERATURE",
      "WEATHER_CONDITION",
      "IS_DAY",
      "HR_SAMPLE_MINUTES",
      "DISPLAY_MODE"
    ],
    "resources": {
      "media": [
        {
          "file": "images/icon.png",
          "name": "MENU_ICON",
          "type": "bitmap",
          "menuIcon": true
        },
        {
          "characterRegex": "[0-9: A-Z°-]",
          "file": "fonts/cabin-medium-500-text-subset.ttf",
          "name": "FONT_CABIN_TEXT_14_MEDIUM",
          "type": "font"
        },
        {
          "characterRegex": "[0-9: A-Z°-]",
          "file": "fonts/cabin-medium-500-text-subset.ttf",
          "name": "FONT_CABIN_TEXT_18_MEDIUM",
          "type": "font"
        },
        {
          "characterRegex": "[0-9:]",
          "file": "fonts/cabin-semibold-600-time-subset.ttf",
          "name": "FONT_CABIN_TIME_36_SEMIBOLD",
          "type": "font"
        },
        {
          "characterRegex": "[0-9:]",
          "file": "fonts/cabin-semibold-600-time-subset.ttf",
          "name": "FONT_CABIN_TIME_48_SEMIBOLD",
          "type": "font"
        },
        {
          "file": "images/walk_16.png",
          "name": "WALK_COMPACT",
          "type": "bitmap",
          "targetPlatforms": ["aplite", "chalk", "flint", "basalt", "diorite"]
        },
        {
          "file": "images/walk_24.png",
          "name": "WALK_FULL",
          "type": "bitmap",
          "targetPlatforms": ["emery", "gabbro"]
        }
      ]
    }
  }
}
