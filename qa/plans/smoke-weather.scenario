PREAMBLE
  SCREENSHOTS yes
  EMULATORS emery chalk
  DISPLAYS celeste oxford white black
END

EXECUTE
  STEP battery charging=1 level=81
  STEP weather is_day=1 temp=250 code=0
  STEP weather is_day=1 temp=250 code=1
  STEP weather is_day=1 temp=250 code=2
  STEP weather is_day=1 temp=250 code=3
  STEP weather is_day=0 temp=250 code=0
  STEP weather is_day=0 temp=250 code=1
  STEP weather is_day=0 temp=250 code=2
  STEP weather is_day=0 temp=250 code=3
  STEP weather is_day=0 temp=250 code=99
  STEP weather is_day=0 temp=250 code=66
  STEP weather is_day=0 temp=250 code=67
  STEP weather is_day=0 temp=250 code=77
  STEP weather is_day=0 temp=250 code=85
  STEP weather is_day=0 temp=250 code=57
END
