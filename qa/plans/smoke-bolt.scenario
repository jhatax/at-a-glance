PREAMBLE
  SCREENSHOTS yes
  EMULATORS emery chalk gabbro
  DISPLAYS celeste oxford white black
END

EXECUTE
  STEP battery charging=1 level=81 orientation=0
  STEP weather is_day=1 temp=250 code=99
  STEP weather is_day=0 temp=250 code=99
  STEP battery charging=1 level=81 orientation=1
  STEP weather is_day=1 temp=250 code=99
  STEP weather is_day=0 temp=250 code=99
END
