PREAMBLE
  SCENARIO release-full
  SCREENSHOTS yes
END

EXECUTE
  STEP weather emulator=aplite display=white temp=539 code=0 is_day=1
  STEP weather emulator=basalt display=black temp=539 code=65 is_day=0
  STEP weather emulator=chalk display=white temp=539 code=80 is_day=1
  STEP weather emulator=diorite display=black temp=539 code=95 is_day=0
  STEP weather emulator=emery display=white temp=539 code=71 is_day=1
  STEP weather emulator=flint display=black temp=539 code=82 is_day=0
  STEP weather emulator=gabbro display=white temp=539 code=3 is_day=1
  STEP battery emulator=aplite display=white level=10 charging=0
  STEP battery emulator=basalt display=black level=25 charging=1
  STEP battery emulator=chalk display=white level=50 charging=0
  STEP battery emulator=diorite display=black level=70 charging=1
  STEP battery emulator=emery display=white level=80 charging=0
  STEP battery emulator=flint display=black level=90 charging=1
  STEP battery emulator=gabbro display=white level=100 charging=0
  STEP health emulator=aplite display=white bpm=99 steps=1000
  STEP health emulator=basalt display=black bpm=101 steps=8000
  STEP health emulator=chalk display=white bpm=121 steps=11000
  STEP health emulator=diorite display=black bpm=0 steps=0
  STEP health emulator=emery display=white bpm=99 steps=8000
  STEP health emulator=flint display=black bpm=101 steps=11000
  STEP health emulator=gabbro display=white bpm=121 steps=1000
END
