PREAMBLE
  SCENARIO release-core
  SCREENSHOTS yes
END

EXECUTE
  STEP weather emulator=emery display=white temp=539 code=65 is_day=1
  STEP weather emulator=flint display=black temp=539 code=0 is_day=0
  STEP battery emulator=chalk display=black level=25 charging=0
  STEP battery emulator=aplite display=white level=100 charging=1
  STEP health emulator=emery display=white bpm=121 steps=11000
  STEP health emulator=chalk display=black bpm=99 steps=8000
END
