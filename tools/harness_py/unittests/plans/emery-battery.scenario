PREAMBLE
  SCENARIO emery-battery
  SCREENSHOTS yes
  EMULATORS emery
END

EXECUTE
  STEP battery display=white level=19 charging=0
  STEP battery display=white level=49 charging=0
  STEP battery display=white level=81 charging=0
  STEP battery display=white level=100 charging=0
  STEP battery display=white level=40 charging=1
  STEP battery display=white level=80 charging=1
END
